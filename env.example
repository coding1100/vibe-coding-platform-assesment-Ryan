# ============================================
# Vibe Coding Platform - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your actual values
# cp env.example .env.local

# ============================================
# e2b Configuration
# ============================================
# Get your API key from: https://e2b.dev
# Required for sandbox creation and code execution
E2B_API_KEY=your_e2b_api_key_here

# ============================================
# Trigger.dev Configuration
# ============================================
# Get your API key from: https://trigger.dev
# Required for workflow orchestration
TRIGGER_API_KEY=your_trigger_api_key_here

# Optional: Trigger.dev API URL (defaults to https://api.trigger.dev)
# Only change if using a custom Trigger.dev instance
TRIGGER_API_URL=https://api.trigger.dev

# ============================================
# AI Gateway Configuration
# ============================================
# Optional: Vercel AI Gateway configuration
# Only needed if using Vercel AI Gateway (not required for basic setup)
# Get from: https://vercel.com/docs/ai-gateway
# Option 1: Use API key
AI_GATEWAY_API_KEY=your_ai_gateway_api_key_here
# Option 2: Use base URL (alternative to API key)
AI_GATEWAY_BASE_URL=
# Note: If neither is set, the app will work without AI Gateway (uses direct OpenAI)

# ============================================
# OpenAI Configuration (Optional)
# ============================================
# Only needed if not using AI Gateway
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# Next.js Configuration
# ============================================
# Environment: development, production, or test
NODE_ENV=development

# ============================================
# Notes
# ============================================
# 1. E2B_API_KEY is REQUIRED for sandbox operations
# 2. TRIGGER_API_KEY is REQUIRED for Trigger.dev workflows
# 3. AI_GATEWAY_BASE_URL is optional if using Vercel AI Gateway
# 4. OPENAI_API_KEY is optional if using AI Gateway (Gateway handles auth)
# 5. Never commit .env.local to version control (it's in .gitignore)

